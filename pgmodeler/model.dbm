<?xml version="1.0" encoding="UTF-8"?>
<!--
CAUTION: Do not modify this file unless you know what you are doing.
 Unexpected results may occur if the code is changed deliberately.
-->
<dbmodel pgmodeler-ver="1.2.3" use-changelog="false" max-obj-count="4"
	 gen-disabled-objs-code="false" show-sys-schemas-rects="true"
	 last-position="0,0" last-zoom="0.8" scene-rect="-680,0,2250.8,1076.8"
	 default-schema="public" default-owner="postgres"
	 layers="Default layer"
	 active-layers="0"
	 layer-name-colors="#000000"
	 layer-rect-colors="#b4b4b4"
	 show-layer-names="false" show-layer-rects="false">
<database name="TaskFile" is-template="false" allow-conns="true">
</database>

<schema name="public" layers="0" fill-color="#e1e1e1" name-color="#000000" sql-disabled="true">
</schema>

<table name="Task" layers="0" collapse-mode="2" max-obj-count="8" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="360" y="600"/>
	<column name="task_id" not-null="true" default-value="gen_random_uuid()">
		<type name="uuid" length="128"/>
	</column>
	<column name="name" not-null="true">
		<type name="varchar" length="64"/>
	</column>
	<column name="description">
		<type name="text" length="0"/>
	</column>
	<column name="completed" not-null="true" default-value="false">
		<type name="bool" length="0"/>
	</column>
	<column name="created_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="priority" not-null="true" default-value="0">
		<type name="smallint" length="0"/>
	</column>
	<column name="user_id" not-null="true">
		<type name="uuid" length="40"/>
	</column>
	<constraint name="Task_pk" type="pk-constr" table="public.&quot;Task&quot;">
		<columns names="task_id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="File" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="960" y="560"/>
	<column name="file_id" not-null="true" default-value="gen_random_uuid()">
		<type name="uuid" length="0"/>
	</column>
	<column name="name" not-null="true">
		<type name="varchar" length="48"/>
	</column>
	<column name="path" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="uploaded_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamp" length="0"/>
	</column>
	<column name="last_download_at">
		<type name="timestamp" length="0"/>
	</column>
	<column name="task_id" not-null="true">
		<type name="uuid" length="128"/>
	</column>
	<constraint name="FIle_pk" type="pk-constr" table="public.&quot;File&quot;">
		<columns names="file_id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="User" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="-100" y="240"/>
	<column name="user_id" not-null="true" default-value="gen_random_uuid()">
		<type name="uuid" length="40"/>
	</column>
	<column name="name" not-null="true">
		<type name="varchar" length="256"/>
	</column>
	<column name="email" not-null="true">
		<type name="varchar" length="256"/>
	</column>
	<column name="password_hash" not-null="true">
		<type name="varchar" length="256"/>
	</column>
	<column name="created_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="active" not-null="true" default-value="true">
		<type name="boolean" length="0"/>
	</column>
	<constraint name="User_pk" type="pk-constr" table="public.&quot;User&quot;">
		<columns names="user_id" ref-type="src-columns"/>
	</constraint>
	<constraint name="unique_email" type="uq-constr" table="public.&quot;User&quot;">
		<columns names="email" ref-type="src-columns"/>
	</constraint>
</table>

<table name="Session" layers="0" collapse-mode="2" max-obj-count="8" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="-620" y="480"/>
	<column name="session_id" not-null="true" default-value="gen_random_uuid()">
		<type name="uuid" length="0"/>
	</column>
	<column name="user_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="token_hash" not-null="true">
		<type name="varchar" length="64"/>
	</column>
	<column name="expires_at" not-null="true">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="created_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="revoked_at">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="user_agent">
		<type name="text" length="0"/>
	</column>
	<constraint name="Session_pk" type="pk-constr" table="public.&quot;Session&quot;">
		<columns names="session_id" ref-type="src-columns"/>
	</constraint>
</table>

<constraint name="fk_id_usuario(User-Task)" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="NO ACTION" ref-table="public.&quot;User&quot;" table="public.&quot;Task&quot;">
	<columns names="user_id" ref-type="src-columns"/>
	<columns names="user_id" ref-type="dst-columns"/>
</constraint>

<constraint name="fk-task_id(File)-task_id(Task)" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="NO ACTION" ref-table="public.&quot;Task&quot;" table="public.&quot;File&quot;">
	<columns names="task_id" ref-type="src-columns"/>
	<columns names="task_id" ref-type="dst-columns"/>
</constraint>

<constraint name="fk-user_id(Session-User)" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="NO ACTION" ref-table="public.&quot;User&quot;" table="public.&quot;Session&quot;">
	<columns names="user_id" ref-type="src-columns"/>
	<columns names="user_id" ref-type="dst-columns"/>
</constraint>

<relationship name="&quot;rel_FIle_Task&quot;" type="relfk" layers="0"
	 src-table="public.&quot;File&quot;"
	 dst-table="public.&quot;Task&quot;" reference-fk="fk-task_id(File)-task_id(Task)"
	 src-required="false" dst-required="true"/>

<relationship name="&quot;rel_Task_User&quot;" type="relfk" layers="0"
	 src-table="public.&quot;Task&quot;"
	 dst-table="public.&quot;User&quot;" reference-fk="fk_id_usuario(User-Task)"
	 src-required="false" dst-required="true"/>

<relationship name="&quot;rel_Session_User&quot;" type="relfk" layers="0"
	 src-table="public.&quot;Session&quot;"
	 dst-table="public.&quot;User&quot;" reference-fk="fk-user_id(Session-User)"
	 src-required="false" dst-required="true"/>

</dbmodel>
