generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model File {
  file_id          String    @id(map: "FIle_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String    @db.VarChar(48)
  path             String
  uploaded_at      DateTime  @default(now()) @db.Timestamp(6)
  last_download_at DateTime? @db.Timestamp(6)
  task_id          String    @db.Uuid
  Task             Task      @relation(fields: [task_id], references: [task_id], onDelete: NoAction, onUpdate: NoAction, map: "fk-task_id(File)-task_id(Task)")
}

model Session {
  session_id String    @id(map: "Session_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @db.VarChar(64)
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  user_agent String?
  User       User      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk-user_id(Session-User)")
}

model Task {
  task_id     String   @id(map: "Task_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(64)
  description String?
  completed   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  priority    Int      @default(0) @db.SmallInt
  user_id     String   @db.Uuid
  File        File[]
  User        User     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_id_usuario(User-Task)")
}

model User {
  user_id       String    @id(map: "User_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar(256)
  email         String    @unique(map: "unique_email") @db.VarChar(256)
  password_hash String?   @db.VarChar(256)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  active        Boolean   @default(true)
  google_id     String?   @unique @db.VarChar(256)
  Session       Session[]
  Task          Task[]
}
